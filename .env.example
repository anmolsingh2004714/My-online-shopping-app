DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
DB_PORT=3306

# Random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL=
EMAIL_PASSWORD=

# Comma separated e-mail addresses allowed to access /admin and product management
ADMIN_EMAILS=

# Set to 0 only when running locally over plain HTTP
SESSION_COOKIE_SECURE=1
